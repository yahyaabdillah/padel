// PadelHub — TENANT (per-club) database schema
//
// TABLE NAMING CONVENTION
//   m_*  = MASTER / configuration tables. Set up by the club, rarely change,
//          NOT wiped on an app reset (m_user, m_court, m_operating_hours,
//          m_membership_plan).
//   t_*  = TRANSACTIONAL tables. Day-to-day operational records that ARE wiped
//          on an app reset (t_member, t_booking, t_booking_detail,
//          t_court_maintenance). Reset with: npm run db:reset-transactional
//
// AUDIT CONVENTION (every model):
//   createdAt / createdBy · updatedAt / updatedBy · deletedAt / deletedBy
//   isDeleted (0 = live, 1 = soft-deleted). Never hard-delete: set isDeleted=1
//   and stamp deletedAt/deletedBy instead (soft delete). The transactional
//   reset truncates t_* tables entirely (hard wipe) for a clean slate.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// ════════════════════════════════════════════════════════════
//  MASTER / CONFIG TABLES (m_*)
// ════════════════════════════════════════════════════════════

/// An INTERNAL login subject inside a tenant (owner / staff / coach / superadmin).
/// Role is resolved against the MASTER database via roleKey.
model m_user {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.VarChar(50) // matches m_tenant.companyId in master
  userId       String    @db.VarChar(100) // login username (lowercase)
  passwordHash String    @db.Text
  roleKey      String    @db.VarChar(50) // superadmin|owner|staff|coach
  namalengkap  String?   @db.VarChar(255)
  email        String?   @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  photo        String?   @db.VarChar(255)
  isActive     Boolean   @default(true)
  lastLogin    DateTime? @db.Timestamp(0)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([roleKey])
  @@index([isDeleted])
}

/// Per-user menu access OVERRIDE. Sits ON TOP of the role's m_role_menu grants
/// (resolved from the master DB). When a row exists for (userId, menuKey), its
/// flags REPLACE the role grant for that menu for that user. Lives in the tenant
/// DB because users are tenant-scoped. menuKey references master m_menu.key.
model m_user_menu {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.VarChar(50)
  userId    String  @db.Uuid // m_user.id
  menuKey   String  @db.VarChar(100) // master m_menu.key
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  canCancel Boolean @default(false)
  canImport Boolean @default(false)
  canExport Boolean @default(false)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@unique([userId, menuKey])
  @@index([companyId])
  @@index([userId])
}

/// Operating hours master — club's open window per weekday (7 rows, day 0–6).
model m_operating_hours {
  id        Int     @id @default(autoincrement())
  companyId String  @db.VarChar(50)
  day       Int // 0 = Sunday … 6 = Saturday
  open      Boolean @default(true)
  openStart Int     @default(7) // hour 0–23
  openEnd   Int     @default(23) // hour 1–24

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@unique([companyId, day])
  @@index([companyId])
}

/// Court master — padel courts owned by this tenant/club.
model m_court {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.VarChar(50)
  name         String  @db.VarChar(100)
  environment  String  @db.VarChar(20) // indoor, outdoor
  wall         String  @db.VarChar(20) // glass, mesh
  format       String  @db.VarChar(20) // single, double
  status       String  @default("active") @db.VarChar(20) // active, maintenance, inactive
  priceOffPeak Int // IDR per hour (off-peak/normal)
  pricePeak    Int // IDR per hour (peak)
  /// DaySchedule[] JSON: [{day:0, available:true, slots:["regular","peak",...]}, ...]
  /// 7 entries, 48 slots each (30-min storage resolution). "closed" slots are
  /// outside operating hours; day-off is handled by the Maintenance module.
  schedule     Json
  color        String  @default("#6D5BFF") @db.VarChar(20)
  note         String? @db.Text
  image        String? @db.VarChar(255)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  bookingDetails t_booking_detail[]
  maintenances   t_court_maintenance[]

  @@index([companyId])
  @@index([status])
  @@index([isDeleted])
}

/// Membership plan (benefits + court-booking quota), configured by the club.
/// Benefits are consumed by the shared calcMembershipBenefit() helper.
model m_membership_plan {
  id                    String  @id @default(uuid()) @db.Uuid
  companyId             String  @db.VarChar(50)
  name                  String  @db.VarChar(100)
  color                 String  @default("#6D5BFF") @db.VarChar(20)
  /// one-time join fee in IDR (0 = none)
  joinFee               Int     @default(0)
  /// free court bookings included per cycle
  includedCourtBookings Int     @default(0)
  /// days before the quota cycle resets (0 = never)
  resetPeriodDays       Int     @default(30)
  /// free coaching sessions per cycle
  freeCoaching          Int     @default(0)
  /// % discount on court rate after quota is used up (0–100)
  courtDiscountPct      Int     @default(0)
  /// marketing bullet points
  perks                 Json
  active                Boolean @default(true)
  highlighted           Boolean @default(false)
  /// display order
  sortOrder             Int     @default(0)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  members t_member[]

  @@index([companyId])
  @@index([active])
  @@index([isDeleted])
}

/// Coach master — coaching staff. Availability is stored per weekday as a JSON
/// array of 7 entries (day 0–6) describing whether the coach works that day and
/// the hour window [start, end). Sessions are checked against this + existing
/// session bookings to find an available coach.
model m_coach {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.VarChar(50)
  name        String  @db.VarChar(255)
  level       String  @default("Pro") @db.VarChar(40) // Head Coach|Senior|Pro|Assistant
  status      String  @default("active") @db.VarChar(20) // active|on_leave|inactive
  phone       String? @db.VarChar(30)
  email       String? @db.VarChar(150)
  avatar      String? @db.VarChar(255)
  color       String  @default("#6D5BFF") @db.VarChar(20)
  /// hourly PT rate (IDR) — informational
  ratePerHour Int     @default(0)
  /// comma-free JSON string[] of specialties
  specialties Json
  bio         String? @db.Text
  /// CoachAvailability[]: [{day:1, works:true, start:9, end:21}, ...] (7 entries)
  availability Json

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  sessions t_coaching_session[]

  @@index([companyId])
  @@index([status])
  @@index([isDeleted])
}

/// Coaching package master — a bundle of N sessions sold for a flat fee.
model m_coach_package {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.VarChar(50)
  name      String  @db.VarChar(100)
  /// number of sessions (meetings) in the package
  sessions  Int     @default(1)
  /// session duration in minutes
  durationMin Int   @default(60)
  /// total package fee (IDR)
  price     Int     @default(0)
  color     String  @default("#14B8A6") @db.VarChar(20)
  note      String? @db.Text
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  schedules t_coaching_schedule[]

  @@index([companyId])
  @@index([active])
  @@index([isDeleted])
}

// ════════════════════════════════════════════════════════════
//  TRANSACTIONAL TABLES (t_*) — wiped on app reset
// ════════════════════════════════════════════════════════════

/// Club member (player CRM) AND a login subject for the member portal.
/// Transactional: members are created by day-to-day registration and are wiped
/// on an app reset. Members are SEPARATE from internal users (m_user); both can
/// log in, but members are customers while m_user are internal team.
model t_member {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.VarChar(50)
  memberNo     String    @db.VarChar(40) // PHB-2026-xxxx
  /// login username for the member portal (lowercase, unique per tenant)
  username     String    @db.VarChar(100)
  /// bcrypt hash; members can log in to the member portal
  passwordHash String    @db.Text
  name         String    @db.VarChar(255)
  phone        String    @db.VarChar(30)
  email        String?   @db.VarChar(150)
  /// legacy tier label (kept for display); real benefits come from planId
  tier         String    @default("daily") @db.VarChar(20)
  status       String    @default("active") @db.VarChar(20) // active|inactive|frozen
  city         String?   @db.VarChar(100)
  avatar       String?   @db.VarChar(255)
  onboarded    Boolean   @default(false)
  lastLogin    DateTime? @db.Timestamp(0)

  // ── membership assignment (benefits resolved from m_membership_plan) ──
  /// assigned plan; null = no active membership (plain / walk-in)
  planId       String?   @db.Uuid
  /// ISO date the current quota cycle started (for reset rollover)
  cycleStart   DateTime? @db.Timestamp(0)
  /// court bookings consumed in the current cycle
  quotaUsed    Int       @default(0)
  /// free coaching sessions consumed in the current cycle
  coachingUsed Int       @default(0)
  /// whether the plan's one-time join fee has been collected
  joinFeePaid  Boolean   @default(false)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  bookings t_booking[]
  plan     m_membership_plan? @relation(fields: [planId], references: [id])
  coachingSchedules t_coaching_schedule[]

  @@unique([companyId, memberNo])
  @@unique([companyId, username])
  @@index([companyId])
  @@index([phone])
  @@index([status])
  @@index([planId])
  @@index([isDeleted])
}

/// A booking TRANSACTION header. One per checkout — groups one or more court
/// sessions (t_booking_detail) paid together. Payment + totals live here.
model t_booking {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @db.VarChar(50)
  memberId      String? @db.Uuid // null for walk-in / unregistered
  type          String  @default("member") @db.VarChar(20) // member|walk_in|coaching|event
  status        String  @default("confirmed") @db.VarChar(20) // confirmed|pending|checked_in|completed|cancelled
  customer      String  @db.VarChar(255) // display label
  /// payment method used at checkout (Cash|Card|QRIS|Wallet)
  paymentMethod String? @db.VarChar(20)
  /// sum of all detail line prices actually charged (IDR)
  totalPrice    Int     @default(0)
  /// one-time membership join fee collected in this transaction (IDR)
  joinFee       Int     @default(0)
  /// membership quota slots consumed by this transaction
  quotaConsumed Int     @default(0)
  note          String? @db.Text

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  member  t_member?          @relation(fields: [memberId], references: [id])
  details t_booking_detail[]

  @@index([companyId])
  @@index([memberId])
  @@index([status])
  @@index([isDeleted])
}

/// A single court session line within a booking transaction. Each line is one
/// court at one time window; the calendar / availability read these directly.
model t_booking_detail {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.VarChar(50)
  bookingId String   @db.Uuid // FK → t_booking header
  courtId   String   @db.Uuid
  start     DateTime @db.Timestamp(0)
  end       DateTime @db.Timestamp(0)
  partySize Int      @default(4)
  /// court rate before membership benefit (IDR)
  basePrice Int      @default(0)
  /// amount actually charged for this line after benefit (IDR)
  price     Int      @default(0)
  /// regular|peak|free (quota)|discount — informational
  rateNote  String?  @db.VarChar(40)
  /// confirmed|cancelled|checked_in|completed (mirrors header but per-line)
  status    String   @default("confirmed") @db.VarChar(20)
  note      String?  @db.Text

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  booking t_booking @relation(fields: [bookingId], references: [id])
  court   m_court   @relation(fields: [courtId], references: [id])

  @@index([companyId])
  @@index([bookingId])
  @@index([courtId])
  @@index([status])
  @@index([start])
  @@index([isDeleted])
}

/// Court maintenance / day-off windows. A court is unavailable for booking
/// during [start, end). Operational records — wiped on an app reset.
model t_court_maintenance {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.VarChar(50)
  courtId   String   @db.Uuid
  /// closure window (inclusive start, exclusive end)
  start     DateTime @db.Timestamp(0)
  end       DateTime @db.Timestamp(0)
  /// short reason shown in the UI (e.g. "Ganti net", "Libur nasional")
  reason    String   @db.VarChar(255)
  /// maintenance | holiday | private_event | other
  kind      String   @default("maintenance") @db.VarChar(20)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  court m_court @relation(fields: [courtId], references: [id])

  @@index([companyId])
  @@index([courtId])
  @@index([start])
  @@index([isDeleted])
}

/// A coaching SCHEDULE — one per member+package enrollment. Holds the weekly
/// cycle config used to generate sessions and the package economics snapshot.
/// Transactional: wiped on app reset.
model t_coaching_schedule {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @db.VarChar(50)
  memberId   String  @db.Uuid
  packageId  String  @db.Uuid
  /// snapshot of the package at enrollment
  packageName String @db.VarChar(100)
  totalSessions Int   @default(1)
  price      Int     @default(0)
  /// first session date (YYYY-MM-DD anchor)
  startDate  DateTime @db.Timestamp(0)
  /// weekly cycle: JSON { days:[1,3,5], time:"18:00", durationMin:60, perWeek:3 }
  cycle      Json
  status     String  @default("active") @db.VarChar(20) // active|completed|cancelled
  note       String? @db.Text

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  member   t_member            @relation(fields: [memberId], references: [id])
  package  m_coach_package     @relation(fields: [packageId], references: [id])
  sessions t_coaching_session[]

  @@index([companyId])
  @@index([memberId])
  @@index([status])
  @@index([isDeleted])
}

/// A single coaching SESSION within a schedule. Coach assignment is per-session
/// (not per-package): each session can have a different coach based on
/// availability and can be manually overridden. Transactional: wiped on reset.
model t_coaching_session {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.VarChar(50)
  scheduleId String   @db.Uuid
  /// assigned coach (nullable when no coach is available at that time)
  coachId    String?  @db.Uuid
  /// 1-based position within the package
  sequence   Int      @default(1)
  start      DateTime @db.Timestamp(0)
  end        DateTime @db.Timestamp(0)
  status     String   @default("scheduled") @db.VarChar(20) // scheduled|completed|cancelled|no_coach
  note       String?  @db.Text

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  schedule t_coaching_schedule @relation(fields: [scheduleId], references: [id])
  coach    m_coach?            @relation(fields: [coachId], references: [id])

  @@index([companyId])
  @@index([scheduleId])
  @@index([coachId])
  @@index([start])
  @@index([status])
  @@index([isDeleted])
}
