// PadelHub — MASTER (engine) database schema
// Shared across the platform: roles, permissions, menu/RBAC, version, tenants registry.
// Tenant business data (users, bookings, members, ...) lives in per-tenant databases.
//
// AUDIT CONVENTION (every model):
//   createdAt / createdBy · updatedAt / updatedBy · deletedAt / deletedBy
//   isDeleted (0 = live, 1 = soft-deleted). Never hard-delete business rows;
//   set isDeleted=1 + deletedAt/deletedBy instead.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

/// A role definition shared by all tenants (superadmin, owner, staff, coach, member).
model m_role {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique @db.VarChar(50) // lowercase canonical: superadmin|owner|staff|coach|member
  name        String              @db.VarChar(100) // display label
  description String?
  scope       String              @default("club") @db.VarChar(20) // platform|club|member
  level       Int                 @default(5) // 1 = highest authority
  isSystem    Boolean             @default(false)
  permissions m_role_permission[]
  roleMenus   m_role_menu[]

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@index([key])
  @@index([isDeleted])
}

/// A discrete permission key (e.g. "booking.create").
model m_permission {
  id        String              @id @default(uuid()) @db.Uuid
  key       String              @unique @db.VarChar(100)
  name      String              @db.VarChar(255)
  groupName String?             @db.VarChar(100)
  roles     m_role_permission[]

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@index([key])
  @@index([isDeleted])
}

/// Many-to-many between roles and permissions.
model m_role_permission {
  id           String       @id @default(uuid()) @db.Uuid
  roleId       String       @db.Uuid
  permissionId String       @db.Uuid
  role         m_role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   m_permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// A sidebar / navigation menu entry. Hierarchical via parentKey. Stored in the
/// master DB so menus + their per-role action permissions are configurable from
/// the Access Control UI (no code change to add/hide a menu).
model m_menu {
  id        String  @id @default(uuid()) @db.Uuid
  /// stable slug key (e.g. "bookings", "members"); used to map role permissions
  key       String  @unique @db.VarChar(100)
  label     String  @db.VarChar(150)
  /// route path; empty for a group parent with children
  path      String  @default("") @db.VarChar(200)
  /// lucide-react export name (e.g. "CalendarDays", "Users")
  icon      String  @default("LayoutGrid") @db.VarChar(60)
  /// parent menu key; null = top-level
  parentKey String? @db.VarChar(100)
  /// sidebar bucket: main | master | others
  groupKey  String  @default("others") @db.VarChar(20)
  /// section heading (Platform | Club | Member) — informational grouping
  section   String  @default("Club") @db.VarChar(40)
  /// display order within its parent/group
  sortOrder Int     @default(0)
  /// optional badge: new | soon | hot
  badge     String? @db.VarChar(20)
  isActive  Boolean @default(true)

  roleMenus m_role_menu[]

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@index([key])
  @@index([parentKey])
  @@index([isDeleted])
}

/// Per-(role, menu) access matrix. Each row holds the 6 granular action flags
/// that gate both menu visibility (canView) and the actions on that page.
model m_role_menu {
  id        String  @id @default(uuid()) @db.Uuid
  roleId    String  @db.Uuid
  menuId    String  @db.Uuid
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  canCancel Boolean @default(false)
  canImport Boolean @default(false)
  canExport Boolean @default(false)

  role m_role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu m_menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@unique([roleId, menuId])
  @@index([roleId])
  @@index([menuId])
}

/// Active app version (kept for parity with sevenrent; used to build dashboard paths).
model m_version {
  id          String  @id @default(uuid()) @db.Uuid
  versionName String  @db.VarChar(50)
  isActive    Boolean @default(true)
  description String?

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)
}

/// Registry of tenants (clubs) and the DB connection used to reach each tenant database.
/// In `custom` mode there is typically exactly one tenant.
model m_tenant {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @unique @db.VarChar(50) // stable lowercase identifier, used at login
  name       String @db.VarChar(255)
  slug       String @unique @db.VarChar(100)
  mode       String @default("custom") @db.VarChar(20) // custom|product
  status     String @default("active") @db.VarChar(20) // active|trial|suspended|past_due
  // Tenant database connection (custom mode: local Postgres)
  dbHost     String @db.VarChar(255)
  dbPort     Int    @default(5432)
  dbName     String @db.VarChar(100)
  dbUsername String @db.VarChar(100)
  dbPassword String @db.VarChar(255)

  // ── audit + soft delete ──
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  updatedBy String?   @db.VarChar(100)
  deletedAt DateTime? @db.Timestamp(0)
  deletedBy String?   @db.VarChar(100)
  isDeleted Int       @default(0)

  @@index([companyId])
  @@index([slug])
  @@index([isDeleted])
}
