  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate --schema=prisma/master.prisma && prisma generate --schema=prisma/tenant.prisma",
    "db:push:master": "prisma db push --schema=prisma/master.prisma",
    "db:push:tenant": "prisma db push --schema=prisma/tenant.prisma",
    "db:push": "npm run db:push:master && npm run db:push:tenant",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-transactional": "tsx prisma/reset-transactional.ts"
  },
