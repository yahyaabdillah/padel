# ─── App mode ──────────────────────────────────────────────
# custom  = standalone deployment, login by username + password
# product = SaaS deployment, wired to membership/license flow
MODE=custom

# ─── MASTER database (engine: roles, permissions, menu, tenant registry) ───
MASTER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/padel_master?schema=public"

# ─── TENANT database (default / fallback) ──────────────────
TENANT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/padel_tenant_smashcourt?schema=public"

# In custom mode this is the single active tenant (matches m_tenant.companyId).
CUSTOM_TENANT_COMPANY_ID="smashcourt"

# HMAC secret for authenticated sessions. Required in production; use at least
# 32 random characters and keep it outside version control.
SESSION_SECRET="change-me-to-a-random-secret-at-least-32-characters"

# AES-256-GCM key for encrypting per-tenant Midtrans Server Keys.
PAYMENT_CONFIG_ENCRYPTION_KEY="change-me-payment-config-key-at-least-32-characters"

# Public application URL registered as the Midtrans payment notification URL.
APP_URL="http://localhost:3000"

# ─── Check-in QR token signing ─────────────────────────────
# HMAC secret for signing booking check-in QR tokens. If unset, a built-in
# fallback is used (set a strong value in production).
CHECKIN_TOKEN_SECRET="change-me-checkin-secret"

# ─── Prisma pool tuning (optional) ─────────────────────────
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT=20
PRISMA_CONNECT_TIMEOUT=10
PRISMA_TENANT_CONNECTION_LIMIT=2
PRISMA_TENANT_POOL_TIMEOUT=20
PRISMA_TENANT_CONNECT_TIMEOUT=10
